# ============================================================
# opportunity-service — Environment Variables
# Copy to .env and fill in your values before running.
# NEVER commit the real .env file to version control.
# ============================================================

# Flask
FLASK_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# MongoDB Atlas — replace <user>, <password>, <cluster>, <appName>
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/opportunity_db?retryWrites=true&w=majority&appName=<appName>
DB_NAME=opportunity_db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
